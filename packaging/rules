#!/usr/bin/make -f
# Debian build rules for Celluloid.
#
# Upstream builds with meson; debhelper's meson buildsystem handles
# configure/build/install. Hardening and reproducible-build flags come from
# dpkg's default feature handling rather than being hardcoded here.

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all reproducible=+fixfilepath

%:
	dh $@ --buildsystem=meson

# po/ carries generated .gmo files and a timestamp marker. If they survive into
# a rebuild, gettext can consider translations up to date and skip regenerating
# them, so they are always removed.
override_dh_clean:
	dh_clean
	-$(RM) po/*.gmo po/stamp-po

# Upstream releases up to 0.27 ship configure.ac alongside meson.build. Its
# presence makes debhelper run dh_autoreconf, which needs autoconf-archive and
# fails without it. The meson build never reads those files, so the whole
# autoreconf step is skipped rather than adding a build dependency we do not use.
override_dh_autoreconf:
	@echo "Skipping dh_autoreconf (meson buildsystem)"

override_dh_update_autotools_config:
	@echo "Skipping dh_update_autotools_config (meson buildsystem)"

# Skip the upstream metadata validators (appstream/desktop/schema checks) that
# meson registers as tests: they only re-validate shipped XML, and would need
# the Debian-packaged versions to agree with upstream's expectations.
override_dh_auto_test:
	@echo "Skipping upstream metadata validation tests"

# Without the backports this is a no-op: the binary links the system GTK and
# shlibdeps resolves everything normally. With them, libgtk-4.so.1 and
# libadwaita-1.so.0 live under /opt/gtk420 and have no shlibs database entry, so
# their dependencies come from debian/shlibs.local (generated by build.sh) and
# the libraries themselves must be excluded from resolution.
ifeq ($(USE_BACKPORTS),1)
override_dh_shlibdeps:
	dh_shlibdeps -- -l/opt/gtk420/lib/x86_64-linux-gnu
endif
