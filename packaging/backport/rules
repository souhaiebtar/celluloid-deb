#!/usr/bin/make -f
# Debian build rules for a private-prefix library backport.
#
# The point is that nothing lands in /usr: meson is configured with this
# package's own prefix, so the resulting .deb contains only files under
# @PREFIX@ and no Debian-packaged library is replaced.

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_BUILD_OPTIONS = noautodbgsym

%:
	dh $@ --buildsystem=meson

# The meson options are essential, not cosmetic: without -Dvulkan=disabled and
# -Dmedia-gstreamer=disabled GTK insists on those dependencies or tries to
# download them as subprojects, which debhelper forbids (--wrap-mode=nodownload).
override_dh_auto_configure:
	dh_auto_configure -- \
	  --prefix=@PREFIX@ \
	  --libdir=@PREFIX@/lib/x86_64-linux-gnu \
	  @MESON_ARGS@

# No system shlibs registration: these libraries are not on the system linker
# path, so other packages must never resolve against them implicitly.
override_dh_makeshlibs:
	@echo "Skipping dh_makeshlibs (private prefix, not a system library)"

# shlibdeps must resolve two different things:
#   - the library this package ships, found via -l on its own staging prefix;
#   - libraries from a *different* backport package (GTK, for libadwaita), whose
#     build directory is passed with -I so shlibdeps can inspect them and derive
#     the real runtime dependency rather than being told to ignore it.
override_dh_shlibdeps:
	dh_shlibdeps -- \
	  -l$(CURDIR)/debian/@PACKAGE@@PREFIX@/lib/x86_64-linux-gnu \
	  @SHLIBDEPS_EXTRA@
